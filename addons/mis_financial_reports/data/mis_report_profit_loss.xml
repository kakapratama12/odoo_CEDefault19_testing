<?xml version="1.0" encoding="utf-8" ?>
<!-- Profit & Loss (Laba Rugi) - Indonesian Chart of Accounts -->
<odoo noupdate="0">
    <!-- ============================================ -->
    <!-- Profit & Loss Report Template                -->
    <!-- ============================================ -->
    <record id="mis_report_profit_loss" model="mis.report">
        <field name="name">Profit &amp; Loss (Laba Rugi)</field>
    </record>

    <!-- ===== REVENUE ===== -->
    <record id="pl_kpi_revenue" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="name">revenue</field>
        <field name="description">Revenue</field>
        <field name="style_id" ref="style_mis_report_kpi_parent" />
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="style_mis_report_detail" />
        <field name="sequence">10</field>
    </record>
    <record id="pl_kpi_revenue_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_revenue" />
        <field name="name">-balp[4%]</field>
    </record>

    <!-- ===== COST OF GOODS SOLD ===== -->
    <record id="pl_kpi_cogs" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="name">cogs</field>
        <field name="description">Cost of Goods Sold</field>
        <field name="style_id" ref="style_mis_report_kpi_parent" />
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="style_mis_report_detail" />
        <field name="sequence">20</field>
    </record>
    <record id="pl_kpi_cogs_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_cogs" />
        <field name="name">balp[5%]</field>
    </record>

    <record id="pl_kpi_gross_profit" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="name">gross_profit</field>
        <field name="description">Gross Profit</field>
        <field name="style_id" ref="style_mis_report_kpi_total" />
        <field name="expression">revenue - cogs</field>
        <field name="sequence">29</field>
    </record>

    <!-- ===== OPERATING EXPENSES ===== -->
    <record id="pl_kpi_salary" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="name">salary_exp</field>
        <field name="description">Salary &amp; Employee Expenses</field>
        <field name="style_id" ref="style_mis_report_kpi_parent" />
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="style_mis_report_detail" />
        <field name="sequence">30</field>
    </record>
    <record id="pl_kpi_salary_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_salary" />
        <field name="name">balp[61%]</field>
    </record>

    <record id="pl_kpi_operational" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="name">operational_exp</field>
        <field name="description">Operational Expenses</field>
        <field name="style_id" ref="style_mis_report_kpi_parent" />
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="style_mis_report_detail" />
        <field name="sequence">40</field>
    </record>
    <record id="pl_kpi_operational_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_operational" />
        <field name="name">balp[62%,63%,64%,65%,66%,67%,68%,69%]</field>
    </record>

    <record id="pl_kpi_other_opex" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="name">other_opex</field>
        <field name="description">Other Expenses</field>
        <field name="style_id" ref="style_mis_report_kpi_parent" />
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="style_mis_report_detail" />
        <field name="sequence">50</field>
    </record>
    <record id="pl_kpi_other_opex_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_other_opex" />
        <field name="name">balp[7%,9%]</field>
    </record>

    <record id="pl_kpi_total_opex" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="name">total_opex</field>
        <field name="description">Total Operating Expenses</field>
        <field name="style_id" ref="style_mis_report_kpi_total" />
        <field name="expression">salary_exp + operational_exp + other_opex</field>
        <field name="sequence">59</field>
    </record>

    <!-- ===== NET INCOME ===== -->
    <record id="pl_kpi_other_income" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="name">other_income</field>
        <field name="description">Other Income</field>
        <field name="style_id" ref="style_mis_report_kpi_parent" />
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="style_mis_report_detail" />
        <field name="sequence">60</field>
    </record>
    <record id="pl_kpi_other_income_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_other_income" />
        <field name="name">-balp[8%]</field>
    </record>

    <record id="pl_kpi_net_income" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="name">net_income</field>
        <field name="description">NET INCOME (LOSS)</field>
        <field name="style_id" ref="style_mis_report_kpi_total" />
        <field name="expression">gross_profit - total_opex + other_income</field>
        <field name="sequence">99</field>
    </record>
</odoo>
