<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- ============================================ -->
    <!-- Improved MIS Report Styles                   -->
    <!-- ============================================ -->

    <!-- Style for Parent KPIs (e.g. "Cash & Bank") -->
    <record id="style_mis_report_kpi_parent" model="mis.report.style">
        <field name="name">KPI Parent Style</field>
        <field name="font_weight">bold</field>
        <field name="font_size">large</field>
        <field name="indent_level">0</field>
        <field name="format_type">accounting</field>
        <field name="format_type_inherit">0</field>
        <field name="css_class">mis_enterprise_header</field>
    </record>

    <!-- Style for KPI Totals (e.g. "Total Assets") -->
    <record id="style_mis_report_kpi_total" model="mis.report.style">
        <field name="name">KPI Total Style</field>
        <field name="font_weight">bold</field>
        <field name="font_size">large</field>
        <field name="indent_level">0</field>
        <field name="border_top">2px solid #000000</field>
        <field name="border_top_inherit">0</field>
        <field name="format_type">accounting</field>
        <field name="format_type_inherit">0</field>
        <field name="css_class">mis_enterprise_total</field>
    </record>

    <!-- Style for Account Details (e.g. "1111 Cash") -->
    <!-- Style for Account Details (e.g. "1111 Cash") -->
    <record id="style_mis_report_detail" model="mis.report.style">
        <field name="name">Account Detail Style</field>
        <field name="indent_level">1</field>
        <field name="indent_level_inherit">0</field>
        <field name="format_type">accounting</field>
        <field name="format_type_inherit">0</field>
        <field name="font_size">medium</field>
        <field name="font_weight">normal</field>
        <field name="css_class">mis_enterprise_detail</field>
    </record>

     <!-- Base Accounting Style (for default KPIs if needed) -->
    <record id="style_mis_report_accounting" model="mis.report.style">
        <field name="name">Accounting Format Style</field>
        <field name="format_type">accounting</field>
        <field name="format_type_inherit">0</field>
    </record>

</odoo>
